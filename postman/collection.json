{
  "info": {
    "_postman_id": "b1c2d3e4-5678-4abc-9def-0123456789ab",
    "name": "Ecommerce API Collection",
    "description": "Collection for the Ecommerce API (NestJS). Register/login in the Auth folder to obtain a JWT, then copy the access token into the environment variable `token`. User-management, product and order ADMIN routes require an ADMIN token. Base URL comes from the `base_url` environment variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
