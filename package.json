{
  "name": "ecommerce-project",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/backend & npm run dev --workspace apps/frontend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace apps/backend",
    "build:frontend": "npm run build --workspace apps/frontend",
    "lint": "npm run lint --workspaces",
    "lint:backend": "npm run lint --workspace apps/backend",
    "lint:frontend": "npm run lint --workspace apps/frontend",
    "test": "npm run test --workspace apps/backend",
    "test:backend": "npm run test --workspace apps/backend",
    "test:e2e": "npm run test:e2e --workspace apps/backend",
    "test:integration": "npm run test:integration --workspace apps/backend",
    "test:all": "npm run test:all --workspace apps/backend",
    "format": "npm run format --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace apps/backend"
  }
}
